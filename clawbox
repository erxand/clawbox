#!/usr/bin/env bash
# clawbox — CLI wrapper for the Clawbox Docker agent
# Install: sudo cp clawbox /usr/local/bin/clawbox && sudo chmod +x /usr/local/bin/clawbox
# Or run: make install

set -euo pipefail

# Find the clawbox project directory
# Prefer CLAWBOX_DIR env var, then look for the dir relative to this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLAWBOX_DIR="${CLAWBOX_DIR:-$SCRIPT_DIR}"

if [ ! -f "$CLAWBOX_DIR/docker-compose.yml" ]; then
  echo "Error: clawbox project not found at $CLAWBOX_DIR"
  echo "Set CLAWBOX_DIR env var or run from the clawbox project directory."
  exit 1
fi

GATEWAY_PORT="${GATEWAY_PORT:-18790}"
GATEWAY_URL="ws://localhost:${GATEWAY_PORT}"
GATEWAY_TOKEN="clawbox"
CONTAINER="clawbox-work"
TASKS_FILE="$HOME/.clawbox-tasks"
LOCK_FILE="$HOME/.clawbox-lock"
TASK_LOG_LINK="$HOME/.clawbox-task.log"  # symlink → latest timestamped log
# TASK_LOG is set per-task to a timestamped file (ISSUE-43); use TASK_LOG_LINK for
# commands that read the "most recent" log (task-status, task-logs, cancel).
TASK_LOG="$TASK_LOG_LINK"  # backward-compat fallback; overridden in cmd_task

# ── Helpers ─────────────────────────────────────────────────────────

check_port() {
  # Try lsof first, fall back to nc
  if command -v lsof &>/dev/null; then
    lsof -ti tcp:"$1" 2>/dev/null | head -1
  else
    # nc -z returns 0 if port is open; we can't get PID but can detect conflict
    if nc -z 127.0.0.1 "$1" 2>/dev/null; then
      echo "unknown"
    fi
  fi
}

assert_container_running() {
  # Check if the container is running and the gateway port is reachable.
  # Prints a clear warning and exits 1 if not, so the user isn't silently
  # routed to the embedded host agent (ISSUE-25).
  local running
  running=$(docker inspect "$CONTAINER" --format '{{.State.Running}}' 2>/dev/null || echo "false")
  if [ "$running" != "true" ]; then
    echo ""
    echo "⚠ WARNING: Clawbox container is not running!"
    echo "  Your request would fall back to the local (host) agent — not the container."
    echo ""
    echo "  To start Clawbox:  clawbox start"
    echo "  To check status:   clawbox status"
    echo ""
    exit 1
  fi

  # Also verify the gateway port is actually reachable (ISSUE-27: container can start
  # without port bindings after a port conflict)
  local port_open
  port_open=$(nc -z 127.0.0.1 "$GATEWAY_PORT" 2>/dev/null && echo "open" || echo "closed")
  if [ "$port_open" != "open" ]; then
    echo ""
    echo "⚠ WARNING: Container is running but port $GATEWAY_PORT is not reachable!"
    echo "  This can happen after a port conflict — the container may have started"
    echo "  without its port mappings. Your request would go to the host agent."
    echo ""
    echo "  Fix: clawbox stop && clawbox start"
    echo "  Or:  cd $CLAWBOX_DIR && docker compose up -d --force-recreate"
    echo ""
    exit 1
  fi
}

assert_not_busy() {
  # Check if another clawbox request is already in-flight (ISSUE-30).
  # Uses a lock file with PID so stale locks from crashed processes are detected.
  # Exits 1 if busy — prevents two concurrent requests from silently queuing with
  # no indication to the user (ISSUE-37: assert_not_busy warned but did not exit).
  if [ -f "$LOCK_FILE" ]; then
    local lock_pid
    lock_pid=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
    # If the PID in the lock file is still running, we're busy
    if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
      echo ""
      echo "⏳ Another Clawbox task is already running (PID $lock_pid)."
      echo "   Wait for it to complete, then retry."
      echo ""
      echo "   To check progress:        clawbox task-status"
      echo "   To tail live output:      clawbox task-logs"
      echo "   To cancel and run yours:  clawbox cancel && clawbox run \"...\""
      echo ""
      exit 1
    else
      # Stale lock — previous process died without cleanup
      rm -f "$LOCK_FILE"
    fi
  fi
}

acquire_lock() {
  echo "$$" > "$LOCK_FILE"
}

release_lock() {
  # Only release if we own the lock
  local lock_pid
  lock_pid=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
  if [ "$lock_pid" = "$$" ]; then
    rm -f "$LOCK_FILE"
  fi
}

# ── Commands ────────────────────────────────────────────────────────

cmd_start() {
  # Port conflict detection
  for PORT in "$GATEWAY_PORT" 3000; do
    PID=$(check_port "$PORT")
    if [ -n "$PID" ]; then
      # Check if it's our own container
      CONTAINER_PID=$(docker inspect "$CONTAINER" --format '{{.State.Pid}}' 2>/dev/null || echo "")
      if [ -n "$CONTAINER_PID" ] && [ "$CONTAINER_PID" != "0" ]; then
        echo "Clawbox is already running. Use 'clawbox stop' first or 'clawbox status' to check."
        exit 1
      fi
      if [ "$PORT" = "$GATEWAY_PORT" ]; then
        echo ""
        echo "⚠ Port $PORT is already in use."
        if [ "$PID" != "unknown" ]; then
          echo "  In use by PID $PID. Run: kill $PID or stop whatever is using it."
        fi
        echo ""
        echo "  Or run on a different port:"
        echo "    GATEWAY_PORT=18791 clawbox start"
        echo ""
        echo "  Multiple clawbox instances can run simultaneously on different ports."
        echo "  Set GATEWAY_PORT in your shell to target a specific instance."
      else
        if [ "$PID" = "unknown" ]; then
          echo "⚠ Port $PORT is in use. Stop whatever is using it before starting Clawbox."
        else
          echo "⚠ Port $PORT is in use by PID $PID. Run: kill $PID or stop whatever is using it."
        fi
      fi
      exit 1
    fi
  done

  echo "▶ Starting Clawbox (gateway port: $GATEWAY_PORT)..."
  (cd "$CLAWBOX_DIR" && GATEWAY_PORT="$GATEWAY_PORT" docker compose up -d)

  # Wait for healthy, detect OOM
  echo "Waiting for healthy..."
  for i in $(seq 1 30); do
    # Check if container exited
    RUNNING=$(docker inspect "$CONTAINER" --format '{{.State.Running}}' 2>/dev/null || echo "false")
    if [ "$RUNNING" = "false" ]; then
      OOM=$(docker inspect "$CONTAINER" --format '{{.State.OOMKilled}}' 2>/dev/null || echo "false")
      if [ "$OOM" = "true" ]; then
        echo "✗ Container was killed by OOM — try increasing memory in docker-compose.yml"
        exit 1
      fi
      echo "✗ Container exited unexpectedly. Run: clawbox logs"
      exit 1
    fi

    STATUS=$(docker inspect "$CONTAINER" --format '{{.State.Health.Status}}' 2>/dev/null || echo "missing")
    if [ "$STATUS" = "healthy" ]; then echo "✓ Clawbox is ready."; return; fi
    sleep 1
  done
  echo "⚠ Container may still be starting. Run: clawbox logs"
}

cmd_stop() {
  echo "▶ Stopping Clawbox..."
  (cd "$CLAWBOX_DIR" && GATEWAY_PORT="$GATEWAY_PORT" docker compose down)
}

cmd_restart() {
  cmd_stop
  cmd_start
}

cmd_status() {
  (cd "$CLAWBOX_DIR" && GATEWAY_PORT="$GATEWAY_PORT" docker compose ps)
  echo ""
  echo "Gateway Health"
  OPENCLAW_GATEWAY_URL="$GATEWAY_URL" OPENCLAW_GATEWAY_TOKEN="$GATEWAY_TOKEN" \
    openclaw gateway health 2>/dev/null && echo "Gateway: ✓ healthy" || echo "Gateway: ✗ unreachable"
  echo ""
  echo "Connect:  export OPENCLAW_GATEWAY_URL=${GATEWAY_URL} OPENCLAW_GATEWAY_TOKEN=clawbox"
  echo "Run:      clawbox run \"your message\""
  if [ "$GATEWAY_PORT" != "18790" ]; then
    echo ""
    echo "Note: Non-default gateway port in use (GATEWAY_PORT=$GATEWAY_PORT)"
    echo "      Set GATEWAY_PORT=$GATEWAY_PORT in your shell to target this instance."
  fi
}

cmd_logs() {
  (cd "$CLAWBOX_DIR" && GATEWAY_PORT="$GATEWAY_PORT" docker compose logs -f)
}

cmd_chat() {
  # clawbox chat [--session <name>]
  # --session <name>   Named session key for conversation continuity
  local session_key=""

  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --session|-s)
        session_key="${2:-}"
        if [ -z "$session_key" ]; then
          echo "Usage: clawbox chat --session <name>"
          exit 1
        fi
        shift 2
        ;;
      *)
        echo "Unknown option: ${1:-}"
        echo "Usage: clawbox chat [--session <name>]"
        exit 1
        ;;
    esac
  done

  assert_container_running
  assert_not_busy

  if [ -n "$session_key" ]; then
    echo "▶ Opening Clawbox chat (session: $session_key, Ctrl+C to exit)..."
  else
    echo "▶ Opening Clawbox chat (Ctrl+C to exit)..."
  fi

  acquire_lock
  trap 'release_lock' EXIT INT TERM
  local tui_args=()
  [ -n "$session_key" ] && tui_args+=(--session "$session_key")
  OPENCLAW_GATEWAY_URL="$GATEWAY_URL" OPENCLAW_GATEWAY_TOKEN="$GATEWAY_TOKEN" \
    openclaw tui ${tui_args[@]+"${tui_args[@]}"}
  release_lock
}

cmd_run() {
  # clawbox run [--context <path>] [--thinking <level>] [--session <name>] [--quiet] [--json] [--retry <n>] "your message"
  # --context <path>    Attach file(s) as context (file or directory)
  # --thinking <level>  Thinking level: off|minimal|low|medium|high|xhigh
  # --session <name>    Named session key for conversation continuity (e.g. "myproject")
  # --quiet             Suppress status banners; only print the agent's response
  # --json              Output result as JSON: {response, elapsed_ms, timestamp, context_files}
  # --retry <n>         Retry up to N times (60s delay) if API rate-limited (default: 0)
  local context_path=""
  local thinking_level=""
  local session_key=""
  local output_mode="normal"  # normal | quiet | json
  local retry_max=0
  local message=""

  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --context|-c)
        context_path="${2:-}"
        if [ -z "$context_path" ]; then
          echo "Usage: clawbox run --context <path> \"message\""
          exit 1
        fi
        shift 2
        ;;
      --thinking|-T)
        thinking_level="${2:-}"
        if [ -z "$thinking_level" ]; then
          echo "Usage: clawbox run --thinking <level> \"message\""
          exit 1
        fi
        shift 2
        ;;
      --session|-s)
        session_key="${2:-}"
        if [ -z "$session_key" ]; then
          echo "Usage: clawbox run --session <name> \"message\""
          exit 1
        fi
        shift 2
        ;;
      --quiet|-q)
        output_mode="quiet"
        shift
        ;;
      --json|-j)
        output_mode="json"
        shift
        ;;
      --retry|-r)
        retry_max="${2:-}"
        if [ -z "$retry_max" ] || ! [[ "$retry_max" =~ ^[0-9]+$ ]]; then
          echo "Usage: clawbox run --retry <n> \"message\""
          exit 1
        fi
        shift 2
        ;;
      *)
        message="${1:-}"
        shift
        ;;
    esac
  done

  if [ -z "$message" ]; then
    echo "Usage: clawbox run [--context <path>] [--thinking <level>] [--quiet|--json] \"your message\""
    exit 1
  fi

  # Helper: print status banner only when not in quiet/json mode
  _banner() {
    if [ "$output_mode" = "normal" ]; then
      echo "$@"
    elif [ "$output_mode" = "quiet" ] || [ "$output_mode" = "json" ]; then
      echo "$@" >&2
    fi
  }

  local context_file_count=0

  # Build context block if --context was given
  if [ -n "$context_path" ]; then
    if [ ! -e "$context_path" ]; then
      echo "Error: --context path not found: $context_path" >&2
      exit 1
    fi

    local ctx_block=""
    ctx_block="=== Context files from: $context_path ===\n"

    if [ -f "$context_path" ]; then
      # Single file
      local rel_path
      rel_path=$(basename "$context_path")
      ctx_block+="--- $rel_path ---\n"
      ctx_block+="$(cat "$context_path")\n"
      context_file_count=1
    elif [ -d "$context_path" ]; then
      # Directory — include all non-binary files (skip node_modules, .git, images, etc.)
      local file_count=0
      local max_files=50
      local max_bytes=65536  # 64KB total context limit

      while IFS= read -r -d '' file; do
        [ $file_count -ge $max_files ] && break
        # Skip zero-length or large binary files
        local fsize
        fsize=$(wc -c < "$file" 2>/dev/null || echo 0)
        [ "$fsize" -gt 10240 ] && continue  # skip files >10KB
        local total_so_far=${#ctx_block}
        [ $total_so_far -gt $max_bytes ] && break

        local rel_file
        rel_file="${file#"$context_path/"}"
        ctx_block+="--- $rel_file ---\n"
        ctx_block+="$(cat "$file")\n"
        file_count=$((file_count + 1))
      done < <(find "$context_path" \
        -not -path '*/node_modules/*' \
        -not -path '*/.git/*' \
        -not -path '*/__pycache__/*' \
        -not -path '*/dist/*' \
        -not -path '*/build/*' \
        -not -name '*.png' -not -name '*.jpg' -not -name '*.jpeg' -not -name '*.gif' \
        -not -name '*.svg' -not -name '*.ico' \
        -not -name '*.woff' -not -name '*.woff2' -not -name '*.ttf' \
        -not -name '*.min.js' -not -name '*.min.css' \
        -not -name '*.map' -not -name '*.lock' \
        -type f -print0 | sort -z)

      ctx_block+="=== End of context ($file_count files) ===\n"
      context_file_count=$file_count
      _banner "▶ Attaching $file_count file(s) from $context_path as context..."
    fi

    # Prepend context to message
    message="$(printf '%b' "$ctx_block")\n\n$message"
  fi

  assert_container_running
  assert_not_busy
  acquire_lock
  trap 'release_lock' EXIT INT TERM

  local agent_args=()
  [ -n "$thinking_level" ] && agent_args+=(--thinking "$thinking_level")
  [ -n "$session_key" ]    && agent_args+=(--session-id "$session_key")

  # Use python3 for millisecond timestamps (macOS BSD date doesn't support %N)
  local run_start
  run_start=$(python3 -c "import time; print(int(time.time() * 1000))")

  [ -n "$session_key" ] && _banner "▶ Session: $session_key"

  local response
  local attempt=0
  while true; do
    response=$(OPENCLAW_GATEWAY_URL="$GATEWAY_URL" OPENCLAW_GATEWAY_TOKEN="$GATEWAY_TOKEN" \
      openclaw agent --agent main ${agent_args[@]+"${agent_args[@]}"} -m "$message")

    # ISSUE-44: Detect API rate limit in response. Rate-limited responses contain
    # the phrase "API rate limit reached" from the OpenClaw gateway. Also detect
    # Anthropic's overloaded_error which surfaces with the same user impact.
    if echo "$response" | grep -qi "API rate limit reached\|rate limit reached\|rate_limit_error\|overloaded_error"; then
      if [ "$attempt" -lt "$retry_max" ]; then
        attempt=$((attempt + 1))
        _banner "⚠ Rate limited by API (attempt $attempt/$retry_max). Waiting 60s before retry..."
        release_lock
        sleep 60
        acquire_lock
      else
        # No more retries — emit rate-limit sentinel to stderr + exit 2
        echo "" >&2
        echo "⚠ CLAWBOX_RATE_LIMITED: API rate limit reached. Retry later or use --retry <n>." >&2
        echo "CLAWBOX_RATE_LIMITED" >&2
        release_lock
        exit 2
      fi
    else
      break
    fi
  done

  local run_end
  run_end=$(python3 -c "import time; print(int(time.time() * 1000))")
  local elapsed_ms=$(( run_end - run_start ))

  release_lock

  case "$output_mode" in
    normal|quiet)
      printf '%s\n' "$response"
      ;;
    json)
      # Emit compact JSON: {response, elapsed_ms, timestamp, context_files, session}
      # Use python3 for proper JSON escaping (jq not always available)
      local ts
      ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      python3 -c "
import json, sys
data = {
    'response': sys.argv[1],
    'elapsed_ms': int(sys.argv[2]),
    'timestamp': sys.argv[3],
    'context_files': int(sys.argv[4]),
    'session': sys.argv[5] if sys.argv[5] else None,
}
print(json.dumps(data))
" "$response" "$elapsed_ms" "$ts" "$context_file_count" "$session_key"
      ;;
  esac
}

cmd_shell() {
  docker exec -it "$CONTAINER" sh
}

cmd_cp() {
  if [ -z "${1:-}" ] || [ -z "${2:-}" ]; then
    echo "Usage: clawbox cp <local-path> <container-path>"
    exit 1
  fi
  local src="$1"
  local dest="$2"
  echo "▶ Copying $src → $CONTAINER:$dest ..."
  docker cp "$src" "$CONTAINER:$dest"
  docker exec -u root "$CONTAINER" chown -R node:node "$dest"
  echo "✓ Copied and ownership fixed."
}

cmd_task() {
  # clawbox task [--context <path>] [--thinking <level>] [--session <name>] [--timeout <min>] "description"
  # Runs a task in the background; supports the same flags as `run`.
  # --context <path>    Attach file/dir as context (same as run --context)
  # --thinking <level>  Thinking level: off|minimal|low|medium|high|xhigh
  # --session <name>    Named session for conversation continuity
  # --timeout <min>     Kill agent after N minutes and send handoff prompt (0 = no timeout)
  local context_path=""
  local thinking_level=""
  local session_key=""
  local timeout_min=0
  local desc=""

  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --context|-c)
        context_path="${2:-}"
        if [ -z "$context_path" ]; then
          echo "Usage: clawbox task --context <path> \"description\""
          exit 1
        fi
        shift 2
        ;;
      --thinking|-T)
        thinking_level="${2:-}"
        if [ -z "$thinking_level" ]; then
          echo "Usage: clawbox task --thinking <level> \"description\""
          exit 1
        fi
        shift 2
        ;;
      --session|-s)
        session_key="${2:-}"
        if [ -z "$session_key" ]; then
          echo "Usage: clawbox task --session <name> \"description\""
          exit 1
        fi
        shift 2
        ;;
      --timeout|-t)
        timeout_min="${2:-}"
        if [ -z "$timeout_min" ] || ! [[ "$timeout_min" =~ ^[0-9]+$ ]]; then
          echo "Usage: clawbox task --timeout <minutes> \"description\""
          exit 1
        fi
        shift 2
        ;;
      *)
        desc="${1:-}"
        shift
        ;;
    esac
  done

  if [ -z "$desc" ]; then
    echo "Usage: clawbox task [--context <path>] [--thinking <level>] [--session <name>] [--timeout <min>] \"description\""
    exit 1
  fi

  assert_container_running
  assert_not_busy
  local ts
  ts=$(date '+%Y-%m-%d %H:%M:%S')
  echo "$ts | $desc" >> "$TASKS_FILE"

  # Build context block if --context given (mirrors cmd_run logic)
  local context_file_count=0
  if [ -n "$context_path" ]; then
    if [ ! -e "$context_path" ]; then
      echo "Error: --context path not found: $context_path" >&2
      exit 1
    fi
    local ctx_block=""
    ctx_block="=== Context files from: $context_path ===\n"
    if [ -f "$context_path" ]; then
      ctx_block+="--- $(basename "$context_path") ---\n"
      ctx_block+="$(cat "$context_path")\n"
      context_file_count=1
    elif [ -d "$context_path" ]; then
      local file_count=0
      local max_files=50
      local max_bytes=65536
      while IFS= read -r -d '' file; do
        [ $file_count -ge $max_files ] && break
        local fsize
        fsize=$(wc -c < "$file" 2>/dev/null || echo 0)
        [ "$fsize" -gt 10240 ] && continue
        local total_so_far=${#ctx_block}
        [ $total_so_far -gt $max_bytes ] && break
        local rel_file="${file#"$context_path/"}"
        ctx_block+="--- $rel_file ---\n"
        ctx_block+="$(cat "$file")\n"
        file_count=$((file_count + 1))
      done < <(find "$context_path" \
        -not -path '*/node_modules/*' -not -path '*/.git/*' \
        -not -path '*/__pycache__/*' -not -path '*/dist/*' -not -path '*/build/*' \
        -not -name '*.png' -not -name '*.jpg' -not -name '*.jpeg' -not -name '*.gif' \
        -not -name '*.svg' -not -name '*.ico' \
        -not -name '*.woff' -not -name '*.woff2' -not -name '*.ttf' \
        -not -name '*.min.js' -not -name '*.min.css' -not -name '*.map' -not -name '*.lock' \
        -type f -print0 | sort -z)
      ctx_block+="=== End of context ($file_count files) ===\n"
      context_file_count=$file_count
      echo "▶ Attaching $file_count file(s) from $context_path as context..."
    fi
    desc="$(printf '%b' "$ctx_block")\n\n$desc"
  fi

  # Capture flags for background subshell
  local agent_args=()
  [ -n "$thinking_level" ] && agent_args+=(--thinking "$thinking_level")
  [ -n "$session_key" ]    && agent_args+=(--session-id "$session_key")

  # ISSUE-43: use a timestamped log file; update the symlink to point to it.
  local log_ts
  log_ts=$(date +%Y%m%d-%H%M%S)
  local task_log_file="$HOME/.clawbox-task-${log_ts}.log"
  # Update symlink atomically so task-logs/task-status always read the latest
  ln -sf "$task_log_file" "$TASK_LOG_LINK"
  # Export the path so cmd_cancel's appending works when lock is still held
  TASK_LOG="$task_log_file"

  # Run in background, redirect output to log file so it doesn't bleed to terminal (ISSUE-36)
  (
    acquire_lock
    trap 'release_lock' EXIT INT TERM
    {
      echo "=== Task started: $ts ==="
      echo "Description: ${desc:0:200}"
      [ $context_file_count -gt 0 ] && echo "Context files: $context_file_count"
      [ -n "$session_key" ] && echo "Session: $session_key"
      [ "$timeout_min" -gt 0 ] && echo "Timeout: ${timeout_min}m"
      echo ""

      # Run agent, optionally with a wall-clock timeout (ISSUE-42)
      # macOS doesn't ship `timeout` (GNU coreutils); use a watchdog subshell instead.
      # Note: we're inside a background (subshell), not a function — use plain vars.
      timed_out=0
      if [ "$timeout_min" -gt 0 ]; then
        timeout_secs=$(( timeout_min * 60 ))
        # Spawn agent in background, capture its PID
        OPENCLAW_GATEWAY_URL="$GATEWAY_URL" OPENCLAW_GATEWAY_TOKEN="$GATEWAY_TOKEN" \
          openclaw agent --agent main ${agent_args[@]+"${agent_args[@]}"} -m "$desc" &
        agent_pid=$!
        # Watchdog: sleep timeout_secs, then kill the agent if still running
        ( sleep "$timeout_secs"
          if kill -0 "$agent_pid" 2>/dev/null; then
            kill -TERM "$agent_pid" 2>/dev/null
            sleep 3
            kill -0 "$agent_pid" 2>/dev/null && kill -KILL "$agent_pid" 2>/dev/null || true
          fi
        ) &
        watchdog_pid=$!
        # Wait for agent; suppress set -e on failure to capture timed_out correctly
        agent_wait_ok=1
        wait "$agent_pid" 2>/dev/null || agent_wait_ok=0
        if [ "$agent_wait_ok" -eq 0 ]; then
          # Agent exited non-zero; if watchdog is still alive it means watchdog killed it
          if kill -0 "$watchdog_pid" 2>/dev/null; then
            timed_out=1
          fi
        fi
        # Kill watchdog if agent finished first (normal completion)
        kill "$watchdog_pid" 2>/dev/null || true
        wait "$watchdog_pid" 2>/dev/null || true
      else
        OPENCLAW_GATEWAY_URL="$GATEWAY_URL" OPENCLAW_GATEWAY_TOKEN="$GATEWAY_TOKEN" \
          openclaw agent --agent main ${agent_args[@]+"${agent_args[@]}"} -m "$desc"
      fi

      # Handoff prompt on timeout (ISSUE-42): ask agent to summarise and update TASK.md
      if [ "$timed_out" -eq 1 ]; then
        echo ""
        echo "=== TIMEOUT after ${timeout_min}m — sending handoff prompt ==="
        # Use a fresh session for the handoff to avoid connecting to a broken/mid-turn
        # session state left by the killed agent process. The handoff session reads the
        # container workspace (TASK.md, git log) and writes a clean summary.
        handoff_session="handoff-$(date +%s)"
        handoff_msg="HANDOFF TASK: The previous agent session was stopped after ${timeout_min} minutes. Please do the following:
1. Look at the workspace in /home/node/.openclaw/workspace/ — find any project directories and TASK.md files.
2. Write or update TASK.md in the most recent project directory with:
   - What was completed (based on files present and git log)
   - What still needs to be done
   - The exact next step to continue
3. Commit any uncommitted work with git (run 'git -C <project-dir> add -A && git -C <project-dir> commit -m \"WIP: timeout checkpoint\"' if there are uncommitted files).
4. Write a brief progress summary to stdout.

This is a handoff checkpoint — make TASK.md accurate so the next session can resume immediately."
        echo ""
        echo "--- Handoff response ---"
        # The timed-out agent left the container gateway mid-turn (WebSocket dropped).
        # Send SIGUSR1 to the gateway process to reload it, then wait for it to come back.
        # This avoids a full container restart while clearing the stuck session state.
        gateway_pid=$(docker exec "$CONTAINER" sh -c "pgrep openclaw-gateway | head -1" 2>/dev/null || true)
        if [ -n "$gateway_pid" ]; then
          docker exec "$CONTAINER" kill -USR1 "$gateway_pid" 2>/dev/null || true
        fi
        # Poll for gateway health instead of fixed sleep — more reliable across cold/warm starts
        local gw_ready=0
        for _i in $(seq 1 30); do
          sleep 2
          if OPENCLAW_GATEWAY_URL="$GATEWAY_URL" OPENCLAW_GATEWAY_TOKEN="$GATEWAY_TOKEN" \
             openclaw status >/dev/null 2>&1; then
            gw_ready=1
            break
          fi
        done
        if [ "$gw_ready" -eq 0 ]; then
          echo "⚠ Gateway did not come back healthy after SIGUSR1 reload — handoff may use fallback agent"
        fi
        OPENCLAW_GATEWAY_URL="$GATEWAY_URL" OPENCLAW_GATEWAY_TOKEN="$GATEWAY_TOKEN" \
          openclaw agent --agent main --session-id "$handoff_session" -m "$handoff_msg" || true
        echo ""
        echo "=== Handoff complete: $(date '+%Y-%m-%d %H:%M:%S') ==="
        echo "=== Resume with: clawbox task --session <name> \"continue from TASK.md\" ==="
      else
        echo ""
        echo "=== Task completed: $(date '+%Y-%m-%d %H:%M:%S') ==="
      fi
    } > "$task_log_file" 2>&1
    release_lock
  ) &
  echo "▶ Task started in background."
  [ -n "$session_key" ] && echo "  Session: $session_key"
  [ $context_file_count -gt 0 ] && echo "  Context: $context_file_count file(s) from $context_path"
  [ "$timeout_min" -gt 0 ] && echo "  Timeout: ${timeout_min}m (handoff prompt sent on expiry)"
  echo "  Log:     $task_log_file"
  echo "  Output:  clawbox task-logs   (tail -f the latest log)"
  echo "  Status:  clawbox task-status (full status + history)"
}

cmd_task_status() {
  # Check if a background task is currently running
  if [ -f "$LOCK_FILE" ]; then
    local lock_pid
    lock_pid=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
    if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
      echo "⏳ Background task is running (PID $lock_pid)"
      echo "   To cancel: clawbox cancel"
      echo ""
    fi
  fi

  # Show last background task log (ISSUE-36: agent output redirect)
  if [ -f "$TASK_LOG_LINK" ]; then
    local resolved_log
    resolved_log=$(readlink "$TASK_LOG_LINK" 2>/dev/null || echo "$TASK_LOG_LINK")
    echo "=== Last background task output (tail -30) ==="
    tail -30 "$resolved_log"
    echo ""
    echo "Full log: $resolved_log"
    echo ""
  fi

  if [ -f "$TASKS_FILE" ]; then
    echo "=== Task history ($TASKS_FILE) ==="
    tail -10 "$TASKS_FILE"
    echo ""
  else
    echo "No tasks recorded yet."
    echo ""
  fi

  echo "=== Active task (TASK.md) ==="
  docker exec "$CONTAINER" sh -c "find /home/node/.openclaw/workspace -name TASK.md -not -path '*/node_modules/*' 2>/dev/null | head -5 | while read f; do echo \"--- \$f ---\"; cat \"\$f\"; echo; done" 2>/dev/null || echo "No active task file found in workspace."
}

cmd_task_logs() {
  # Live-tail the background task log (ISSUE-36 follow-up: make live output easy to access)
  if [ ! -f "$TASK_LOG_LINK" ]; then
    echo "No background task log found at $TASK_LOG_LINK"
    echo "Start a task first: clawbox task \"description\""
    exit 1
  fi
  # Resolve symlink to show the actual file (ISSUE-43)
  local resolved_log
  resolved_log=$(readlink "$TASK_LOG_LINK" 2>/dev/null || echo "$TASK_LOG_LINK")
  echo "▶ Tailing $resolved_log (Ctrl+C to stop)..."
  echo ""
  tail -f "$resolved_log"
}

cmd_cancel() {
  # Cancel the currently running background task (ISSUE-40).
  # Sends SIGTERM to the task PID, waits up to 5s for clean exit, then SIGKILL.
  # Cleans up the lock file so the next task can run immediately.
  if [ ! -f "$LOCK_FILE" ]; then
    echo "No background task is currently running."
    echo "Check status with: clawbox task-status"
    exit 0
  fi

  local lock_pid
  lock_pid=$(cat "$LOCK_FILE" 2>/dev/null || echo "")

  if [ -z "$lock_pid" ]; then
    echo "Lock file exists but contains no PID. Cleaning up..."
    rm -f "$LOCK_FILE"
    exit 0
  fi

  if ! kill -0 "$lock_pid" 2>/dev/null; then
    echo "Lock file has stale PID $lock_pid (process not running). Cleaning up..."
    rm -f "$LOCK_FILE"
    exit 0
  fi

  echo "▶ Cancelling task (PID $lock_pid)..."

  # Graceful SIGTERM first
  kill -TERM "$lock_pid" 2>/dev/null || true

  # Wait up to 5 seconds for graceful exit
  local waited=0
  while kill -0 "$lock_pid" 2>/dev/null && [ $waited -lt 5 ]; do
    sleep 1
    waited=$((waited + 1))
  done

  # If still alive, force-kill
  if kill -0 "$lock_pid" 2>/dev/null; then
    echo "  Process didn't exit after ${waited}s — sending SIGKILL..."
    kill -KILL "$lock_pid" 2>/dev/null || true
    sleep 1
  fi

  # Ensure lock is cleaned up (task EXIT trap may not have run if SIGKILL was needed)
  if [ -f "$LOCK_FILE" ]; then
    local remaining_pid
    remaining_pid=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
    if [ "$remaining_pid" = "$lock_pid" ]; then
      rm -f "$LOCK_FILE"
    fi
  fi

  # Append cancellation marker to log (ISSUE-43: resolve symlink first)
  local cancel_log="$TASK_LOG_LINK"
  if [ -L "$TASK_LOG_LINK" ]; then
    cancel_log=$(readlink "$TASK_LOG_LINK" 2>/dev/null || echo "$TASK_LOG_LINK")
  fi
  if [ -f "$cancel_log" ]; then
    echo "" >> "$cancel_log"
    echo "=== Task cancelled by user: $(date '+%Y-%m-%d %H:%M:%S') ===" >> "$cancel_log"
  fi

  echo "✓ Task cancelled."
  echo ""
  echo "  Last output: clawbox task-logs"
  echo "  Start a new task: clawbox task \"description\""
}

cmd_ask() {
  # ask is an alias for run — supports the same flags
  cmd_run "$@"
}

cmd_logs_tail() {
  docker exec "$CONTAINER" tail -50 "/tmp/openclaw/openclaw-$(date +%Y-%m-%d).log" 2>/dev/null || echo "No log file found for today."
}

cmd_backup() {
  (cd "$CLAWBOX_DIR" && make backup)
}

cmd_restore() {
  if [ -z "${1:-}" ]; then
    echo "Usage: clawbox restore <path/to/backup.tar.gz>"
    exit 1
  fi
  (cd "$CLAWBOX_DIR" && make restore FILE="$1")
}

cmd_upgrade() {
  echo "▶ Upgrading Clawbox to latest OpenClaw..."
  (cd "$CLAWBOX_DIR" && GATEWAY_PORT="$GATEWAY_PORT" docker compose down && \
    GATEWAY_PORT="$GATEWAY_PORT" docker compose build --no-cache && \
    GATEWAY_PORT="$GATEWAY_PORT" docker compose up -d)
}

cmd_clean() {
  echo "⚠ This will STOP the container and DELETE all agent data."
  read -rp "Are you sure? [y/N] " confirm
  if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
    (cd "$CLAWBOX_DIR" && GATEWAY_PORT="$GATEWAY_PORT" docker compose down -v)
    echo "Cleaned."
  else
    echo "Aborted."
  fi
}

cmd_install() {
  INSTALL_PATH="/usr/local/bin/clawbox"
  echo "▶ Installing clawbox CLI to $INSTALL_PATH..."
  sudo cp "$SCRIPT_DIR/clawbox" "$INSTALL_PATH"
  sudo chmod +x "$INSTALL_PATH"
  # Store the project dir so the installed binary can find it
  sudo sed -i '' "s|CLAWBOX_DIR:-\$SCRIPT_DIR|CLAWBOX_DIR:-$SCRIPT_DIR|g" "$INSTALL_PATH" 2>/dev/null || true
  echo "✓ Installed. Run: clawbox help"
}

cmd_doctor() {
  # Comprehensive self-diagnostic — checks prerequisites, container health,
  # gateway reachability, disk/memory, and common config issues.
  # Exit 0 if all critical checks pass; exit 1 if any critical check fails.
  local PASS=0 WARN=0 FAIL=0

  _doc_pass() { echo "  ✓ $*"; PASS=$((PASS+1)); }
  _doc_warn() { echo "  ⚠ $*"; WARN=$((WARN+1)); }
  _doc_fail() { echo "  ✗ $*"; FAIL=$((FAIL+1)); }

  echo ""
  echo "🩺 Clawbox Doctor"
  echo "════════════════════════════════════════"
  echo ""

  # ── 1. Prerequisites ─────────────────────────────────────────────
  echo "── Prerequisites ──"

  # docker
  if command -v docker &>/dev/null; then
    local docker_ver
    docker_ver=$(docker --version 2>/dev/null | head -1 || echo "unknown")
    _doc_pass "docker present: $docker_ver"
  else
    _doc_fail "docker not found — install Docker Desktop or Docker Engine"
  fi

  # docker daemon running
  if docker info &>/dev/null 2>&1; then
    _doc_pass "docker daemon is running"
  else
    _doc_fail "docker daemon is not running — start Docker Desktop or run: sudo systemctl start docker"
  fi

  # docker compose (v2 plugin or standalone)
  if docker compose version &>/dev/null 2>&1; then
    _doc_pass "docker compose (v2) available"
  elif command -v docker-compose &>/dev/null; then
    _doc_warn "only docker-compose (v1) found — recommend Docker Compose v2 (docker compose)"
  else
    _doc_fail "docker compose not found — install Docker Compose"
  fi

  # openclaw CLI
  if command -v openclaw &>/dev/null; then
    local oc_ver
    oc_ver=$(openclaw --version 2>/dev/null | head -1 || echo "unknown")
    _doc_pass "openclaw CLI present: $oc_ver"
  else
    _doc_fail "openclaw CLI not found — required for clawbox run/chat/task"
  fi

  # nc (netcat) for port checks
  if command -v nc &>/dev/null; then
    _doc_pass "nc (netcat) available"
  else
    _doc_warn "nc (netcat) not found — port checks may be degraded"
  fi

  echo ""

  # ── 2. Project directory ─────────────────────────────────────────
  echo "── Project Directory ──"
  _doc_pass "CLAWBOX_DIR: $CLAWBOX_DIR"

  if [ -f "$CLAWBOX_DIR/docker-compose.yml" ]; then
    _doc_pass "docker-compose.yml present"
  else
    _doc_fail "docker-compose.yml not found in $CLAWBOX_DIR"
  fi

  if [ -f "$CLAWBOX_DIR/Dockerfile" ]; then
    _doc_pass "Dockerfile present"
  else
    _doc_warn "Dockerfile not found (OK if using pre-built image)"
  fi

  if [ -f "$CLAWBOX_DIR/seed/AGENTS.md" ]; then
    _doc_pass "seed/AGENTS.md present"
  else
    _doc_warn "seed/AGENTS.md not found — agent may lack task-journal and continuity instructions"
  fi

  echo ""

  # ── 3. Container health ──────────────────────────────────────────
  echo "── Container ──"
  local running
  running=$(docker inspect "$CONTAINER" --format '{{.State.Running}}' 2>/dev/null || echo "false")
  local health
  health=$(docker inspect "$CONTAINER" --format '{{.State.Health.Status}}' 2>/dev/null || echo "missing")
  local oom
  oom=$(docker inspect "$CONTAINER" --format '{{.State.OOMKilled}}' 2>/dev/null || echo "false")

  local container_exists
  container_exists=$(docker inspect "$CONTAINER" &>/dev/null && echo "yes" || echo "no")

  if [ "$running" = "true" ]; then
    _doc_pass "container $CONTAINER is running"
  elif [ "$container_exists" = "yes" ]; then
    local exit_code
    exit_code=$(docker inspect "$CONTAINER" --format '{{.State.ExitCode}}' 2>/dev/null || echo "?")
    _doc_fail "container $CONTAINER is stopped (exit code: $exit_code) — run: clawbox start"
  else
    _doc_fail "container $CONTAINER does not exist — run: clawbox start"
  fi

  if [ "$oom" = "true" ]; then
    _doc_fail "container was OOM-killed — increase memory limit in docker-compose.yml"
  fi

  if [ "$running" = "true" ]; then
    if [ "$health" = "healthy" ]; then
      _doc_pass "container health: healthy"
    elif [ "$health" = "starting" ]; then
      _doc_warn "container health: still starting — wait a few seconds and re-run"
    elif [ "$health" = "unhealthy" ]; then
      _doc_fail "container health: unhealthy — run: clawbox logs"
    elif [ "$health" = "missing" ]; then
      _doc_warn "container health: no healthcheck configured"
    fi
  fi

  # read-only rootfs check (only relevant when container exists)
  if [ "$container_exists" = "yes" ]; then
    local readonly_rootfs
    readonly_rootfs=$(docker inspect "$CONTAINER" --format '{{.HostConfig.ReadonlyRootfs}}' 2>/dev/null || echo "unknown")
    if [ "$readonly_rootfs" = "true" ]; then
      _doc_pass "rootfs is read-only (security hardening active)"
    elif [ "$readonly_rootfs" = "false" ]; then
      _doc_warn "rootfs is writable — consider enabling read_only: true in docker-compose.yml"
    fi

    # memory limit
    local mem_limit
    mem_limit=$(docker inspect "$CONTAINER" --format '{{.HostConfig.Memory}}' 2>/dev/null || echo "0")
    if [ "$mem_limit" -gt 0 ] 2>/dev/null; then
      local mem_gb
      mem_gb=$(awk "BEGIN {printf \"%.0f\", $mem_limit / 1073741824}")
      if [ "$mem_gb" -ge 4 ] 2>/dev/null; then
        _doc_pass "memory limit: ${mem_gb}GB"
      else
        _doc_warn "memory limit: ${mem_gb}GB — recommend 4GB+ for heavy builds (Prisma/React/Vite)"
      fi
    else
      _doc_warn "no memory limit set (container can use all host memory)"
    fi
  fi

  echo ""

  # ── 4. Gateway / port ────────────────────────────────────────────
  echo "── Gateway (port $GATEWAY_PORT) ──"

  local port_open
  port_open=$(nc -z 127.0.0.1 "$GATEWAY_PORT" 2>/dev/null && echo "open" || echo "closed")
  if [ "$port_open" = "open" ]; then
    _doc_pass "port $GATEWAY_PORT is reachable"
  else
    _doc_fail "port $GATEWAY_PORT is not reachable — container may not be running or port binding failed"
  fi

  # gateway health check (redirect openclaw stdout so we can test exit code cleanly)
  local gw_health
  if OPENCLAW_GATEWAY_URL="$GATEWAY_URL" OPENCLAW_GATEWAY_TOKEN="$GATEWAY_TOKEN" \
    openclaw gateway health >/dev/null 2>&1; then
    gw_health="healthy"
  else
    gw_health="unreachable"
  fi
  if [ "$gw_health" = "healthy" ]; then
    _doc_pass "gateway health: healthy"
  else
    _doc_fail "gateway health: unreachable — run: clawbox logs"
  fi

  # check for port conflict with non-clawbox process
  if [ "$port_open" = "open" ] && [ "$running" != "true" ]; then
    local conflicting_pid
    conflicting_pid=$(check_port "$GATEWAY_PORT")
    if [ -n "$conflicting_pid" ]; then
      _doc_warn "port $GATEWAY_PORT is held by PID $conflicting_pid (not clawbox) — run: kill $conflicting_pid"
    fi
  fi

  echo ""

  # ── 5. Lock / task state ─────────────────────────────────────────
  echo "── Lock / Task State ──"
  if [ -f "$LOCK_FILE" ]; then
    local lock_pid
    lock_pid=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
    if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
      _doc_warn "lock file held by PID $lock_pid (task in-flight) — run: clawbox task-status"
    else
      _doc_warn "stale lock file found (PID $lock_pid is dead) — run: rm $LOCK_FILE"
    fi
  else
    _doc_pass "no lock file — no task in-flight"
  fi

  if [ -L "$TASK_LOG_LINK" ]; then
    local real_log
    real_log=$(readlink "$TASK_LOG_LINK" 2>/dev/null || echo "")
    if [ -f "$real_log" ]; then
      local log_age
      log_age=$(( $(date +%s) - $(stat -f %m "$real_log" 2>/dev/null || stat -c %Y "$real_log" 2>/dev/null || echo 0) ))
      local log_age_min=$(( log_age / 60 ))
      _doc_pass "task log symlink → $real_log (${log_age_min}m ago)"
    else
      _doc_warn "task log symlink points to missing file: $real_log"
    fi
  else
    _doc_pass "no task log symlink (no prior background task)"
  fi

  echo ""

  # ── 6. Workspace ─────────────────────────────────────────────────
  echo "── Workspace ──"
  if [ "$running" = "true" ]; then
    local ws_result
    ws_result=$(docker exec "$CONTAINER" sh -c "
      WS=/home/node/.openclaw/workspace
      test -d \"\$WS\" || { echo 'MISSING'; exit 0; }
      file_count=\$(find \"\$WS\" -maxdepth 3 -type f ! -path '*/node_modules/*' 2>/dev/null | wc -l | tr -d ' ')
      du_kb=\$(du -sk \"\$WS\" 2>/dev/null | awk '{print \$1}')
      echo \"OK files=\$file_count du_kb=\$du_kb\"
    " 2>/dev/null || echo "ERROR")
    if echo "$ws_result" | grep -q "^OK"; then
      local file_count du_kb
      file_count=$(echo "$ws_result" | grep -o 'files=[0-9]*' | cut -d= -f2)
      du_kb=$(echo "$ws_result" | grep -o 'du_kb=[0-9]*' | cut -d= -f2)
      local du_mb=$(( du_kb / 1024 ))
      _doc_pass "workspace present: $file_count files, ~${du_mb}MB"
    elif echo "$ws_result" | grep -q "MISSING"; then
      _doc_warn "workspace directory /home/node/.openclaw/workspace does not exist yet (normal on first run)"
    else
      _doc_warn "could not inspect workspace: $ws_result"
    fi

    # Check for very large workspaces (could cause context overload)
    if [ -n "${du_kb:-}" ] && [ "$du_kb" -gt 512000 ] 2>/dev/null; then
      _doc_warn "workspace is >500MB — large workspaces can slow down context injection (--context flag)"
    fi

    # Check for agent seed files in container
    local seed_check
    seed_check=$(docker exec "$CONTAINER" sh -c "
      test -f /home/node/.openclaw/workspace/AGENTS.md && echo 'yes' || echo 'no'
    " 2>/dev/null || echo "unknown")
    if [ "$seed_check" = "yes" ]; then
      _doc_pass "AGENTS.md present in container workspace"
    else
      _doc_warn "AGENTS.md not found in container workspace — agent may not have task-journal instructions"
    fi
  else
    _doc_warn "container not running — skipping workspace checks"
  fi

  echo ""

  # ── 7. Host disk space ───────────────────────────────────────────
  echo "── Host Disk ──"
  local disk_avail_kb
  disk_avail_kb=$(df -k "$CLAWBOX_DIR" 2>/dev/null | tail -1 | awk '{print $4}' || echo "0")
  local disk_avail_gb=$(( disk_avail_kb / 1048576 ))
  if [ "$disk_avail_gb" -ge 10 ] 2>/dev/null; then
    _doc_pass "host disk available: ~${disk_avail_gb}GB"
  elif [ "$disk_avail_gb" -ge 5 ] 2>/dev/null; then
    _doc_warn "host disk available: ~${disk_avail_gb}GB (getting low — npm installs need room)"
  else
    _doc_fail "host disk available: ~${disk_avail_gb}GB (critically low — Docker builds may fail)"
  fi

  # Docker disk usage
  local docker_usage
  docker_usage=$(docker system df 2>/dev/null | grep -E "^(Images|Containers|Local Volumes)" | awk '{print $1": "$4}' | tr '\n' ' ' || echo "")
  if [ -n "$docker_usage" ]; then
    _doc_pass "Docker disk usage: $docker_usage"
  fi

  echo ""

  # ── Summary ──────────────────────────────────────────────────────
  local TOTAL=$((PASS + WARN + FAIL))
  echo "════════════════════════════════════════"
  echo "  Pass: $PASS   Warn: $WARN   Fail: $FAIL   (of $TOTAL checks)"
  echo ""
  if [ "$FAIL" -gt 0 ]; then
    echo "  ✗ $FAIL critical issue(s) found — fix the items marked ✗ above."
    echo ""
    exit 1
  elif [ "$WARN" -gt 0 ]; then
    echo "  ⚠ $WARN advisory item(s) — clawbox is functional but review the ⚠ items."
    echo ""
  else
    echo "  ✓ All checks pass — clawbox looks healthy!"
    echo ""
  fi
}

cmd_help() {
  cat << EOF
Clawbox — containerized AI coding agent

Usage: clawbox <command> [args]

Commands:
  start              Start the container
  stop               Stop the container
  restart            Stop then start
  status             Show container + gateway status
  logs               Tail container logs
  chat               Open interactive TUI chat session
  chat --session <name>  Open TUI with a named session (persistent per-project threads)
  run "message"      Send a one-shot message to the agent
  run --context <path> "msg"  Inject file/dir as context before the message
  run --thinking <level> "msg"  Set thinking level (off|minimal|low|medium|high|xhigh)
  run --session <name> "msg"  Use a named session (persistent conversation thread)
  run --quiet "msg"  Suppress status banners; print only the agent's response
  run --json "msg"   Output result as JSON {response, elapsed_ms, timestamp, context_files, session}
  run --retry <n> "msg"  Retry up to N times (60s delay) if API rate-limited (exit 2 on limit)
  ask "question"     Alias for run — supports the same flags
  task "description" Run a task in the background (output saved to ~/.clawbox-task.log)
  task --context <path> "desc"  Background task with file/dir context
  task --thinking <level> "desc"  Background task with thinking level
  task --session <name> "desc"  Background task in a named session
  task --timeout <min> "desc"  Kill agent after N minutes; send handoff prompt to update TASK.md
  task-status        Check background task progress + last task output
  task-logs          Live tail of background task output (tail -f ~/.clawbox-task.log)
  cancel             Cancel the currently running background task
  cp <src> <dest>    Copy file into container (fixes ownership)
  shell              Open a shell inside the container
  logs-tail          Show last 50 lines of today's gateway log
  backup             Backup agent state to tar.gz
  restore <file>     Restore agent state from tar.gz
  upgrade            Rebuild image with latest OpenClaw
  clean              Stop container and delete all data
  install            Install clawbox CLI to /usr/local/bin
  doctor             Run self-diagnostic: checks prereqs, container health, gateway, disk
  help               Show this help

Environment:
  CLAWBOX_DIR        Path to clawbox project (default: script directory)
  GATEWAY_PORT       Gateway port to use (default: 18790)
                     Set to a different port to run multiple clawbox instances:
                       GATEWAY_PORT=18791 clawbox start
                       GATEWAY_PORT=18791 clawbox run "hello"
EOF
}

# ── Dispatch ─────────────────────────────────────────────────────────

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  start)       cmd_start "$@" ;;
  stop)        cmd_stop "$@" ;;
  restart)     cmd_restart "$@" ;;
  status)      cmd_status "$@" ;;
  logs)        cmd_logs "$@" ;;
  chat)        cmd_chat "$@" ;;
  run)         cmd_run "$@" ;;
  ask)         cmd_ask "$@" ;;
  task)        cmd_task "$@" ;;
  task-status) cmd_task_status "$@" ;;
  task-logs)   cmd_task_logs "$@" ;;
  cancel)      cmd_cancel "$@" ;;
  cp)          cmd_cp "$@" ;;
  shell)       cmd_shell "$@" ;;
  logs-tail)   cmd_logs_tail "$@" ;;
  backup)      cmd_backup "$@" ;;
  restore)     cmd_restore "$@" ;;
  upgrade)     cmd_upgrade "$@" ;;
  clean)       cmd_clean "$@" ;;
  install)     cmd_install "$@" ;;
  doctor)      cmd_doctor "$@" ;;
  help|--help|-h) cmd_help ;;
  *)
    echo "Unknown command: $COMMAND"
    echo "Run: clawbox help"
    exit 1
    ;;
esac
