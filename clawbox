#!/usr/bin/env bash
# clawbox — CLI wrapper for the Clawbox Docker agent
# Install: sudo cp clawbox /usr/local/bin/clawbox && sudo chmod +x /usr/local/bin/clawbox
# Or run: make install

set -euo pipefail

# Find the clawbox project directory
# Prefer CLAWBOX_DIR env var, then look for the dir relative to this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLAWBOX_DIR="${CLAWBOX_DIR:-$SCRIPT_DIR}"

if [ ! -f "$CLAWBOX_DIR/docker-compose.yml" ]; then
  echo "Error: clawbox project not found at $CLAWBOX_DIR"
  echo "Set CLAWBOX_DIR env var or run from the clawbox project directory."
  exit 1
fi

GATEWAY_PORT="${GATEWAY_PORT:-18790}"
GATEWAY_URL="ws://localhost:${GATEWAY_PORT}"
GATEWAY_TOKEN="clawbox"
CONTAINER="clawbox-work"
TASKS_FILE="$HOME/.clawbox-tasks"
LOCK_FILE="$HOME/.clawbox-lock"

# ── Helpers ─────────────────────────────────────────────────────────

check_port() {
  # Try lsof first, fall back to nc
  if command -v lsof &>/dev/null; then
    lsof -ti tcp:"$1" 2>/dev/null | head -1
  else
    # nc -z returns 0 if port is open; we can't get PID but can detect conflict
    if nc -z 127.0.0.1 "$1" 2>/dev/null; then
      echo "unknown"
    fi
  fi
}

assert_container_running() {
  # Check if the container is running and the gateway port is reachable.
  # Prints a clear warning and exits 1 if not, so the user isn't silently
  # routed to the embedded host agent (ISSUE-25).
  local running
  running=$(docker inspect "$CONTAINER" --format '{{.State.Running}}' 2>/dev/null || echo "false")
  if [ "$running" != "true" ]; then
    echo ""
    echo "⚠ WARNING: Clawbox container is not running!"
    echo "  Your request would fall back to the local (host) agent — not the container."
    echo ""
    echo "  To start Clawbox:  clawbox start"
    echo "  To check status:   clawbox status"
    echo ""
    exit 1
  fi

  # Also verify the gateway port is actually reachable (ISSUE-27: container can start
  # without port bindings after a port conflict)
  local port_open
  port_open=$(nc -z 127.0.0.1 18790 2>/dev/null && echo "open" || echo "closed")
  if [ "$port_open" != "open" ]; then
    echo ""
    echo "⚠ WARNING: Container is running but port 18790 is not reachable!"
    echo "  This can happen after a port conflict — the container may have started"
    echo "  without its port mappings. Your request would go to the host agent."
    echo ""
    echo "  Fix: clawbox stop && clawbox start"
    echo "  Or:  cd $CLAWBOX_DIR && docker compose up -d --force-recreate"
    echo ""
    exit 1
  fi
}

assert_not_busy() {
  # Check if another clawbox request is already in-flight (ISSUE-30).
  # Uses a lock file with PID so stale locks from crashed processes are detected.
  if [ -f "$LOCK_FILE" ]; then
    local lock_pid
    lock_pid=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
    # If the PID in the lock file is still running, we're busy
    if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
      echo ""
      echo "⏳ Another Clawbox task is already running (PID $lock_pid)."
      echo "   Your request will be queued and start when the current task completes."
      echo ""
      echo "   To check what's running:  clawbox task-status"
      echo "   To cancel and run yours:  kill $lock_pid && clawbox run \"...\""
      echo ""
    else
      # Stale lock — previous process died without cleanup
      rm -f "$LOCK_FILE"
    fi
  fi
}

acquire_lock() {
  echo "$$" > "$LOCK_FILE"
}

release_lock() {
  # Only release if we own the lock
  local lock_pid
  lock_pid=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
  if [ "$lock_pid" = "$$" ]; then
    rm -f "$LOCK_FILE"
  fi
}

# ── Commands ────────────────────────────────────────────────────────

cmd_start() {
  # Port conflict detection
  for PORT in "$GATEWAY_PORT" 3000; do
    PID=$(check_port "$PORT")
    if [ -n "$PID" ]; then
      # Check if it's our own container
      CONTAINER_PID=$(docker inspect "$CONTAINER" --format '{{.State.Pid}}' 2>/dev/null || echo "")
      if [ -n "$CONTAINER_PID" ] && [ "$CONTAINER_PID" != "0" ]; then
        echo "Clawbox is already running. Use 'clawbox stop' first or 'clawbox status' to check."
        exit 1
      fi
      if [ "$PORT" = "$GATEWAY_PORT" ]; then
        echo ""
        echo "⚠ Port $PORT is already in use."
        if [ "$PID" != "unknown" ]; then
          echo "  In use by PID $PID. Run: kill $PID or stop whatever is using it."
        fi
        echo ""
        echo "  Or run on a different port:"
        echo "    GATEWAY_PORT=18791 clawbox start"
        echo ""
        echo "  Multiple clawbox instances can run simultaneously on different ports."
        echo "  Set GATEWAY_PORT in your shell to target a specific instance."
      else
        if [ "$PID" = "unknown" ]; then
          echo "⚠ Port $PORT is in use. Stop whatever is using it before starting Clawbox."
        else
          echo "⚠ Port $PORT is in use by PID $PID. Run: kill $PID or stop whatever is using it."
        fi
      fi
      exit 1
    fi
  done

  echo "▶ Starting Clawbox (gateway port: $GATEWAY_PORT)..."
  (cd "$CLAWBOX_DIR" && GATEWAY_PORT="$GATEWAY_PORT" docker compose up -d)

  # Wait for healthy, detect OOM
  echo "Waiting for healthy..."
  for i in $(seq 1 30); do
    # Check if container exited
    RUNNING=$(docker inspect "$CONTAINER" --format '{{.State.Running}}' 2>/dev/null || echo "false")
    if [ "$RUNNING" = "false" ]; then
      OOM=$(docker inspect "$CONTAINER" --format '{{.State.OOMKilled}}' 2>/dev/null || echo "false")
      if [ "$OOM" = "true" ]; then
        echo "✗ Container was killed by OOM — try increasing memory in docker-compose.yml"
        exit 1
      fi
      echo "✗ Container exited unexpectedly. Run: clawbox logs"
      exit 1
    fi

    STATUS=$(docker inspect "$CONTAINER" --format '{{.State.Health.Status}}' 2>/dev/null || echo "missing")
    if [ "$STATUS" = "healthy" ]; then echo "✓ Clawbox is ready."; return; fi
    sleep 1
  done
  echo "⚠ Container may still be starting. Run: clawbox logs"
}

cmd_stop() {
  echo "▶ Stopping Clawbox..."
  (cd "$CLAWBOX_DIR" && GATEWAY_PORT="$GATEWAY_PORT" docker compose down)
}

cmd_restart() {
  cmd_stop
  cmd_start
}

cmd_status() {
  (cd "$CLAWBOX_DIR" && GATEWAY_PORT="$GATEWAY_PORT" docker compose ps)
  echo ""
  echo "Gateway Health"
  OPENCLAW_GATEWAY_URL="$GATEWAY_URL" OPENCLAW_GATEWAY_TOKEN="$GATEWAY_TOKEN" \
    openclaw gateway health 2>/dev/null && echo "Gateway: ✓ healthy" || echo "Gateway: ✗ unreachable"
  echo ""
  echo "Connect:  export OPENCLAW_GATEWAY_URL=${GATEWAY_URL} OPENCLAW_GATEWAY_TOKEN=clawbox"
  echo "Run:      clawbox run \"your message\""
  if [ "$GATEWAY_PORT" != "18790" ]; then
    echo ""
    echo "Note: Non-default gateway port in use (GATEWAY_PORT=$GATEWAY_PORT)"
    echo "      Set GATEWAY_PORT=$GATEWAY_PORT in your shell to target this instance."
  fi
}

cmd_logs() {
  (cd "$CLAWBOX_DIR" && GATEWAY_PORT="$GATEWAY_PORT" docker compose logs -f)
}

cmd_chat() {
  assert_container_running
  assert_not_busy
  echo "▶ Opening Clawbox chat (Ctrl+C to exit)..."
  acquire_lock
  trap 'release_lock' EXIT INT TERM
  OPENCLAW_GATEWAY_URL="$GATEWAY_URL" OPENCLAW_GATEWAY_TOKEN="$GATEWAY_TOKEN" \
    openclaw tui
  release_lock
}

cmd_run() {
  # clawbox run [--context <path>] [--thinking <level>] [--quiet] [--json] "your message"
  # --context <path>    Attach file(s) as context (file or directory)
  # --thinking <level>  Thinking level: off|minimal|low|medium|high|xhigh
  # --quiet             Suppress status banners; only print the agent's response
  # --json              Output result as JSON: {response, elapsed_ms, timestamp, context_files}
  local context_path=""
  local thinking_level=""
  local output_mode="normal"  # normal | quiet | json
  local message=""

  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --context|-c)
        context_path="${2:-}"
        if [ -z "$context_path" ]; then
          echo "Usage: clawbox run --context <path> \"message\""
          exit 1
        fi
        shift 2
        ;;
      --thinking|-T)
        thinking_level="${2:-}"
        if [ -z "$thinking_level" ]; then
          echo "Usage: clawbox run --thinking <level> \"message\""
          exit 1
        fi
        shift 2
        ;;
      --quiet|-q)
        output_mode="quiet"
        shift
        ;;
      --json|-j)
        output_mode="json"
        shift
        ;;
      *)
        message="${1:-}"
        shift
        ;;
    esac
  done

  if [ -z "$message" ]; then
    echo "Usage: clawbox run [--context <path>] [--thinking <level>] [--quiet|--json] \"your message\""
    exit 1
  fi

  # Helper: print status banner only when not in quiet/json mode
  _banner() {
    if [ "$output_mode" = "normal" ]; then
      echo "$@"
    elif [ "$output_mode" = "quiet" ] || [ "$output_mode" = "json" ]; then
      echo "$@" >&2
    fi
  }

  local context_file_count=0

  # Build context block if --context was given
  if [ -n "$context_path" ]; then
    if [ ! -e "$context_path" ]; then
      echo "Error: --context path not found: $context_path" >&2
      exit 1
    fi

    local ctx_block=""
    ctx_block="=== Context files from: $context_path ===\n"

    if [ -f "$context_path" ]; then
      # Single file
      local rel_path
      rel_path=$(basename "$context_path")
      ctx_block+="--- $rel_path ---\n"
      ctx_block+="$(cat "$context_path")\n"
      context_file_count=1
    elif [ -d "$context_path" ]; then
      # Directory — include all non-binary files (skip node_modules, .git, images, etc.)
      local file_count=0
      local max_files=50
      local max_bytes=65536  # 64KB total context limit

      while IFS= read -r -d '' file; do
        [ $file_count -ge $max_files ] && break
        # Skip zero-length or large binary files
        local fsize
        fsize=$(wc -c < "$file" 2>/dev/null || echo 0)
        [ "$fsize" -gt 10240 ] && continue  # skip files >10KB
        local total_so_far=${#ctx_block}
        [ $total_so_far -gt $max_bytes ] && break

        local rel_file
        rel_file="${file#"$context_path/"}"
        ctx_block+="--- $rel_file ---\n"
        ctx_block+="$(cat "$file")\n"
        file_count=$((file_count + 1))
      done < <(find "$context_path" \
        -not -path '*/node_modules/*' \
        -not -path '*/.git/*' \
        -not -path '*/__pycache__/*' \
        -not -path '*/dist/*' \
        -not -path '*/build/*' \
        -not -name '*.png' -not -name '*.jpg' -not -name '*.jpeg' -not -name '*.gif' \
        -not -name '*.svg' -not -name '*.ico' \
        -not -name '*.woff' -not -name '*.woff2' -not -name '*.ttf' \
        -not -name '*.min.js' -not -name '*.min.css' \
        -not -name '*.map' -not -name '*.lock' \
        -type f -print0 | sort -z)

      ctx_block+="=== End of context ($file_count files) ===\n"
      context_file_count=$file_count
      _banner "▶ Attaching $file_count file(s) from $context_path as context..."
    fi

    # Prepend context to message
    message="$(printf '%b' "$ctx_block")\n\n$message"
  fi

  assert_container_running
  assert_not_busy
  acquire_lock
  trap 'release_lock' EXIT INT TERM

  local agent_args=()
  [ -n "$thinking_level" ] && agent_args+=(--thinking "$thinking_level")

  # Use python3 for millisecond timestamps (macOS BSD date doesn't support %N)
  local run_start
  run_start=$(python3 -c "import time; print(int(time.time() * 1000))")

  local response
  response=$(OPENCLAW_GATEWAY_URL="$GATEWAY_URL" OPENCLAW_GATEWAY_TOKEN="$GATEWAY_TOKEN" \
    openclaw agent --agent main ${agent_args[@]+"${agent_args[@]}"} -m "$message")

  local run_end
  run_end=$(python3 -c "import time; print(int(time.time() * 1000))")
  local elapsed_ms=$(( run_end - run_start ))

  release_lock

  case "$output_mode" in
    normal|quiet)
      printf '%s\n' "$response"
      ;;
    json)
      # Emit compact JSON: {response, elapsed_ms, timestamp, context_files}
      # Use python3 for proper JSON escaping (jq not always available)
      local ts
      ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      python3 -c "
import json, sys
data = {
    'response': sys.argv[1],
    'elapsed_ms': int(sys.argv[2]),
    'timestamp': sys.argv[3],
    'context_files': int(sys.argv[4]),
}
print(json.dumps(data))
" "$response" "$elapsed_ms" "$ts" "$context_file_count"
      ;;
  esac
}

cmd_shell() {
  docker exec -it "$CONTAINER" sh
}

cmd_cp() {
  if [ -z "${1:-}" ] || [ -z "${2:-}" ]; then
    echo "Usage: clawbox cp <local-path> <container-path>"
    exit 1
  fi
  local src="$1"
  local dest="$2"
  echo "▶ Copying $src → $CONTAINER:$dest ..."
  docker cp "$src" "$CONTAINER:$dest"
  docker exec "$CONTAINER" chown -R node:node "$dest"
  echo "✓ Copied and ownership fixed."
}

cmd_task() {
  if [ -z "${1:-}" ]; then
    echo "Usage: clawbox task \"description\""
    exit 1
  fi
  assert_container_running
  assert_not_busy
  local desc="$1"
  local ts
  ts=$(date '+%Y-%m-%d %H:%M:%S')
  echo "$ts | $desc" >> "$TASKS_FILE"
  (
    acquire_lock
    trap 'release_lock' EXIT INT TERM
    OPENCLAW_GATEWAY_URL="$GATEWAY_URL" OPENCLAW_GATEWAY_TOKEN="$GATEWAY_TOKEN" \
      openclaw agent --agent main -m "$desc"
    release_lock
  ) &
  echo "Task started. Run 'clawbox task-status' to check progress."
}

cmd_task_status() {
  if [ -f "$TASKS_FILE" ]; then
    echo "=== Recorded tasks ==="
    cat "$TASKS_FILE"
    echo ""
  else
    echo "No tasks recorded yet."
    echo ""
  fi

  echo "=== Active task (TASK.md) ==="
  docker exec "$CONTAINER" cat /home/node/.openclaw/workspace/TASK.md 2>/dev/null || echo "No active task file found in workspace."
}

cmd_ask() {
  # ask is an alias for run — supports the same flags
  cmd_run "$@"
}

cmd_logs_tail() {
  docker exec "$CONTAINER" tail -50 "/tmp/openclaw/openclaw-$(date +%Y-%m-%d).log" 2>/dev/null || echo "No log file found for today."
}

cmd_backup() {
  (cd "$CLAWBOX_DIR" && make backup)
}

cmd_restore() {
  if [ -z "${1:-}" ]; then
    echo "Usage: clawbox restore <path/to/backup.tar.gz>"
    exit 1
  fi
  (cd "$CLAWBOX_DIR" && make restore FILE="$1")
}

cmd_upgrade() {
  echo "▶ Upgrading Clawbox to latest OpenClaw..."
  (cd "$CLAWBOX_DIR" && GATEWAY_PORT="$GATEWAY_PORT" docker compose down && \
    GATEWAY_PORT="$GATEWAY_PORT" docker compose build --no-cache && \
    GATEWAY_PORT="$GATEWAY_PORT" docker compose up -d)
}

cmd_clean() {
  echo "⚠ This will STOP the container and DELETE all agent data."
  read -rp "Are you sure? [y/N] " confirm
  if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
    (cd "$CLAWBOX_DIR" && GATEWAY_PORT="$GATEWAY_PORT" docker compose down -v)
    echo "Cleaned."
  else
    echo "Aborted."
  fi
}

cmd_install() {
  INSTALL_PATH="/usr/local/bin/clawbox"
  echo "▶ Installing clawbox CLI to $INSTALL_PATH..."
  sudo cp "$SCRIPT_DIR/clawbox" "$INSTALL_PATH"
  sudo chmod +x "$INSTALL_PATH"
  # Store the project dir so the installed binary can find it
  sudo sed -i '' "s|CLAWBOX_DIR:-\$SCRIPT_DIR|CLAWBOX_DIR:-$SCRIPT_DIR|g" "$INSTALL_PATH" 2>/dev/null || true
  echo "✓ Installed. Run: clawbox help"
}

cmd_help() {
  cat << EOF
Clawbox — containerized AI coding agent

Usage: clawbox <command> [args]

Commands:
  start              Start the container
  stop               Stop the container
  restart            Stop then start
  status             Show container + gateway status
  logs               Tail container logs
  chat               Open interactive TUI chat session
  run "message"      Send a one-shot message to the agent
  run --context <path> "msg"  Inject file/dir as context before the message
  run --thinking <level> "msg"  Set thinking level (off|minimal|low|medium|high|xhigh)
  run --quiet "msg"  Suppress status banners; print only the agent's response
  run --json "msg"   Output result as JSON {response, elapsed_ms, timestamp, context_files}
  ask "question"     Alias for run — supports the same flags
  task "description" Run a task in the background
  task-status        Check background task progress
  cp <src> <dest>    Copy file into container (fixes ownership)
  shell              Open a shell inside the container
  logs-tail          Show last 50 lines of today's gateway log
  backup             Backup agent state to tar.gz
  restore <file>     Restore agent state from tar.gz
  upgrade            Rebuild image with latest OpenClaw
  clean              Stop container and delete all data
  install            Install clawbox CLI to /usr/local/bin
  help               Show this help

Environment:
  CLAWBOX_DIR        Path to clawbox project (default: script directory)
  GATEWAY_PORT       Gateway port to use (default: 18790)
                     Set to a different port to run multiple clawbox instances:
                       GATEWAY_PORT=18791 clawbox start
                       GATEWAY_PORT=18791 clawbox run "hello"
EOF
}

# ── Dispatch ─────────────────────────────────────────────────────────

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  start)       cmd_start "$@" ;;
  stop)        cmd_stop "$@" ;;
  restart)     cmd_restart "$@" ;;
  status)      cmd_status "$@" ;;
  logs)        cmd_logs "$@" ;;
  chat)        cmd_chat "$@" ;;
  run)         cmd_run "$@" ;;
  ask)         cmd_ask "$@" ;;
  task)        cmd_task "$@" ;;
  task-status) cmd_task_status "$@" ;;
  cp)          cmd_cp "$@" ;;
  shell)       cmd_shell "$@" ;;
  logs-tail)   cmd_logs_tail "$@" ;;
  backup)      cmd_backup "$@" ;;
  restore)     cmd_restore "$@" ;;
  upgrade)     cmd_upgrade "$@" ;;
  clean)       cmd_clean "$@" ;;
  install)     cmd_install "$@" ;;
  help|--help|-h) cmd_help ;;
  *)
    echo "Unknown command: $COMMAND"
    echo "Run: clawbox help"
    exit 1
    ;;
esac
